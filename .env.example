# Local development only. Copy to .env to override the defaults in
# apps/api/src/api-config.ts. Those defaults match docker-compose.yml.
# The database password is for that local Compose file, not a deployed service.
PORT=3001
DATABASE_URL=postgresql://cro_sport:cro_sport@127.0.0.1:5432/cro_sport
REDIS_URL=redis://127.0.0.1:6379
