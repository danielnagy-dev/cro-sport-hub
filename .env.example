# Copy this file to `.env` in the repository root. `vp run api#dev` reads that file.
# A variable already set in the shell is left as it is.
# Replace the database password below with POSTGRES_PASSWORD from docker-compose.yml.
# That Compose value is not written in this file.
PORT=3001
DATABASE_URL=postgresql://cro_sport:example-db-password@127.0.0.1:5432/cro_sport
REDIS_URL=redis://127.0.0.1:6379
