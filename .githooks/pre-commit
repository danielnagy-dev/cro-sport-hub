#!/bin/sh
# Blocks staged files over 5000 estimated tokens (bytes/4); uses index blobs, not the working tree.
# Same script without --staged runs from `vp run lint` on all tracked files.
# Hooks path: root `prepare` sets core.hooksPath to .githooks (also: git config core.hooksPath .githooks).
set -e
root=$(git rev-parse --show-toplevel)
cd "$root"
if command -v vpx >/dev/null 2>&1; then
  exec vpx tools/guards/file-size.ts --staged
fi
exec "$root/node_modules/.bin/vpx" tools/guards/file-size.ts --staged
